# Supabase (required for auth + database)
# Project URL only — no trailing slash, no /rest/v1 or /auth/v1, no quotes.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for admin scripts / server-side seed jobs. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public site URL for Open Graph / absolute metadata
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
