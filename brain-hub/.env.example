# Required in production (Vercel/Netlify). Local fallback exists only in development.
SESSION_SECRET=replace-with-a-long-random-string

# Optional public site URL for Open Graph / absolute metadata
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Database ---
# Local zero-setup default (used when DATABASE_URL is unset):
#   file:./data/brain-hub.db  (created automatically)
#
# Turso / hosted libSQL for Vercel & Netlify:
DATABASE_URL=libsql://your-db-name-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token
